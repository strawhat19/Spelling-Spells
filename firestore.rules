rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function mappingPath(uid) {
      return /databases/$(database)/documents/authMappings/$(uid);
    }
    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }
    function counterPath() {
      return /databases/$(database)/documents/counters/users;
    }
    function ownAccount(userId) {
      return signedIn()
        && exists(mappingPath(request.auth.uid))
        && get(mappingPath(request.auth.uid)).data.userId == userId
        && get(userPath(userId)).data.firebase_uid == request.auth.uid;
    }
    function ownActiveAccount(userId) {
      return ownAccount(userId) && get(userPath(userId)).data.active == true;
    }
    function validAvatar(value) {
      return value == null || (value is string && value.size() <= 2048
        && value.matches('^https://[^/@\\s?#]+([/?#][^\\s]*)?$'));
    }
    function validProfile(data) {
      return data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.displayName.matches('.*[^\\s].*')
        && validAvatar(data.avatarUrl);
    }
    function validIdentity(userId, number) {
      return number is int && number > 0 && number <= 9007199254740991
        && userId.matches('^User_' + string(number) + '_Account_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }
    function nextNumber(number) {
      return (!exists(counterPath()) && number == 1)
        || (exists(counterPath()) && number == get(counterPath()).data.number + 1);
    }
    function newSubscriber(userId, data) {
      return signedIn()
        && data.keys().hasAll(['id', 'number', 'email', 'firebase_uid', 'displayName', 'avatarUrl', 'role', 'active', 'privacy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'number', 'email', 'firebase_uid', 'displayName', 'avatarUrl', 'role', 'active', 'privacy', 'createdAt', 'updatedAt'])
        && data.id == userId && validIdentity(userId, data.number)
        && data.firebase_uid == request.auth.uid
        && request.auth.token.email is string && data.email == request.auth.token.email
        && data.email.size() >= 3 && data.email.size() <= 320
        && data.role == 'Subscriber' && data.active == true && data.privacy == 'private'
        && validProfile(data)
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function coupledCreation(userId, number) {
      return !exists(mappingPath(request.auth.uid))
        && !exists(userPath(userId))
        && nextNumber(number)
        && getAfter(mappingPath(request.auth.uid)).data.userId == userId
        && getAfter(counterPath()).data.number == number
        && getAfter(counterPath()).data.lastUserId == userId;
    }
    function validCounter(data) {
      return signedIn()
        && data.keys().hasAll(['number', 'lastUserId'])
        && data.keys().hasOnly(['number', 'lastUserId'])
        && validIdentity(data.lastUserId, data.number)
        && coupledCreation(data.lastUserId, data.number)
        && newSubscriber(data.lastUserId, getAfter(userPath(data.lastUserId)).data);
    }
    function existingSpell(spellId) {
      // These are references into the immutable bundled archive, not new spell content IDs.
      return spellId in [
        'Spell_1_Lumos_2026-10-06_719dd0e1-506a-4e67-9b02-04d4af1b4931',
        'Spell_2_Fus-Ro-Dah_2026-10-06_719dd0e2-506a-4e67-9b02-04d4af1b4932',
        'Spell_3_Brisingr_2026-10-06_719dd0e3-506a-4e67-9b02-04d4af1b4933',
        'Spell_4_Alohomora_2026-10-06_719dd0e4-506a-4e67-9b02-04d4af1b4934',
        'Spell_5_Wingardium-Leviosa_2026-10-06_719dd0e5-506a-4e67-9b02-04d4af1b4935',
        'Spell_6_Expelliarmus_2026-10-06_719dd0e6-506a-4e67-9b02-04d4af1b4936',
        'Spell_7_Expecto-Patronum_2026-10-06_719dd0e7-506a-4e67-9b02-04d4af1b4937',
        'Spell_8_Adurna_2026-10-06_719dd0e8-506a-4e67-9b02-04d4af1b4938',
        'Spell_9_Jierda_2026-10-06_719dd0e9-506a-4e67-9b02-04d4af1b4939'
      ];
    }

    match /authMappings/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, update, delete: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.createdAt == request.time
        && newSubscriber(request.resource.data.userId, getAfter(userPath(request.resource.data.userId)).data)
        && coupledCreation(request.resource.data.userId, getAfter(userPath(request.resource.data.userId)).data.number);
    }
    match /counters/users {
      allow get: if signedIn() && !exists(mappingPath(request.auth.uid));
      allow list, delete: if false;
      allow create, update: if validCounter(request.resource.data);
    }
    match /users/{userId} {
      allow get: if ownAccount(userId);
      allow list, delete: if false;
      allow create: if newSubscriber(userId, request.resource.data)
        && coupledCreation(userId, request.resource.data.number);
      allow update: if ownActiveAccount(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      match /savedSpells/{spellId} {
        allow get: if ownActiveAccount(userId);
        allow list: if ownActiveAccount(userId) && request.query.limit != null && request.query.limit <= 501;
        allow create: if ownActiveAccount(userId) && existingSpell(spellId)
          && request.resource.data.keys().hasAll(['spellId', 'savedAt'])
          && request.resource.data.keys().hasOnly(['spellId', 'savedAt'])
          && request.resource.data.spellId == spellId
          && request.resource.data.savedAt == request.time;
        allow update: if false;
        allow delete: if ownActiveAccount(userId);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
