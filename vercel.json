{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run export:web",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": { "api/billing.ts": { "maxDuration": 60 } },
  "redirects": [
    { "source": "/admin/features", "destination": "/features", "permanent": true },
    { "source": "/plan", "destination": "/pricing", "permanent": true },
    { "source": "/plans", "destination": "/pricing", "permanent": true },
    { "source": "/upgrade", "destination": "/pricing", "permanent": true },
    { "source": "/upgrades", "destination": "/pricing", "permanent": true },
    { "source": "/membership", "destination": "/pricing", "permanent": true },
    { "source": "/memberships", "destination": "/pricing", "permanent": true },
    { "source": "/subscription", "destination": "/pricing", "permanent": true },
    { "source": "/subscriptions", "destination": "/pricing", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/billing/:operation", "destination": "/api/billing?operation=:operation" },
    { "source": "/spell/:slug", "destination": "/spell" },
    { "source": "/world/:slug", "destination": "/world" },
    { "source": "/notifications/:slug", "destination": "/notification-details" }
  ]
}
