{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run export:web",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/spell/:slug", "destination": "/spell" },
    { "source": "/world/:slug", "destination": "/world" },
    { "source": "/notifications/:slug", "destination": "/notification-details" }
  ]
}
