# Public Firebase web app identifiers. Copy only from the approved dedicated project.
# These are intentionally empty: missing configuration keeps account services unavailable.
# The source-controlled release hold in src/shared/firebase/config.ts also keeps Firebase off.
# Setting these values alone does not release authentication or cloud sync.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Do not add service-account JSON, private keys, session tokens or reporting tokens here.
# Vercel analytics collection/reporting is not enabled in this account/save stage.
