# Public Supabase configuration. These values are included in the Expo client bundle.
# Target URL: https://qtfajiuilwdtywkklbjq.supabase.co
# Use an enabled sb_publishable_ key from that project. Never a secret/service-role key.
# Empty values keep account services unavailable; guest bookmarks remain on the device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public AdSense publisher ID, read only while finalizing the web export.
# Leave blank until you supply your own pub- identifier. This does not enable ads.
ADSENSE_PUBLISHER_ID=

# Server billing configuration. Keep all values below out of EXPO_PUBLIC_ variables.
# Copy the real values from the ignored .env into the intended Vercel environment before release.
# This template intentionally contains no credentials or configured provider resource IDs.
BILLING_APP_ID=
BILLING_SITE_URL=
STRIPE_ACCOUNT_ID=
STRIPE_LIVE_MODE=
STRIPE_BILLING_SERVER_KEY=
SUPABASE_SECRET_KEY=
STRIPE_STARTER_PRODUCT_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_ENDPOINT_ID=
STRIPE_WEBHOOK_SECRET=

# Never add database passwords, OAuth secrets, user session tokens or reporting tokens.
# Existing analytics collection and provider reporting remain separate from billing setup.
