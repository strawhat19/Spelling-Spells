    "node": "24.21.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "export:web": "node scripts/prepare-catalog-build.cjs && expo export --platform web && node scripts/finalize-catalog-build.cjs",
    "catalog:seed": "node scripts/catalog-seed.cjs",
    "test:catalog": "node --test tests/catalog-contracts.cjs",
    "test:catalog:security": "node supabase/tests/run-catalog-security.cjs",
    "test:web:auth": "node tests/browser/auth-flow-smoke.cjs",
    "test:web:unconfigured": "node tests/browser/unconfigured-smoke.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.0",
    "gsap": "3.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
