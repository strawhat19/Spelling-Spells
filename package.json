    "@electric-sql/pglite": "0.3.14",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.3",
    "playwright": "1.64.1",
    "sass": "^1.89.0",
    "typescript": "~6.0.3"
  }
